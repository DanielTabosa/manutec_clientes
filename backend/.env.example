DJANGO_SECRET_KEY=troque-por-uma-chave-local-aleatoria
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
POSTGRES_DB=manutec_clientes
POSTGRES_USER=postgres
POSTGRES_PASSWORD=
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
# Envio de documentos (conta de e-mail do domínio no cPanel). Porta 465 com SSL ou 587 com TLS.
DJANGO_EMAIL_HOST=
DJANGO_EMAIL_PORT=465
DJANGO_EMAIL_USE_SSL=True
DJANGO_EMAIL_USE_TLS=False
DJANGO_EMAIL_USER=
DJANGO_EMAIL_PASSWORD=
DJANGO_EMAIL_FROM=Manutec Válvulas <financeiro@exemplo.com.br>
DJANGO_EMAIL_REPLY_TO=
# Pasta dos PDFs das preparações (fora do Git). Padrão: backend/privado
DJANGO_ARQUIVOS_PRIVADOS=
# Conta Azul no painel (boleto e NFS-e): producao, desenvolvimento ou vazio para desabilitar.
DJANGO_CONTAAZUL_AMBIENTE=
# Integração Jiraya: token de serviço só de leitura (mínimo 32 caracteres). Vazio = integração desligada.
# Gere com: python -c "import secrets; print(secrets.token_urlsafe(48))"
DJANGO_INTEGRACAO_JIRAYA_TOKEN=
